# FullStrength.ai - Environment Nutrition Service
# Configuration & Secrets Template
# Rename this file to .env and insert your real credentials.

# OpenWeather API Key (Free tier key from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# RPE model used by POST /api/v1/rpe/predict (research demo switch).
#   baseline       -> artifacts/best_rpe_model.joblib (Ridge, default)
#   pp1_optimized  -> artifacts/pp1_model_optimization/best_rpe_model_pp1.joblib (ElasticNet)
# Unsupported values stop the service at start-up; there is no silent fallback.
RPE_MODEL_VARIANT=baseline

# Optional: external research data (PMData / SoccerMon) - not part of the repository.
# RESEARCH_DATA_DIR=D:/ResearchData
# PMDATA_RAW_DIR=D:/ResearchData/pmdata_selected
# PMDATA_EXPERIMENTS_DIR=D:/ResearchData/pmdata_experiments
# PMDATA_MERGED_CSV=D:/ResearchData/pmdata_merged_sessions.csv
# SOCCERMON_DIR=D:/ResearchData/soccermon
